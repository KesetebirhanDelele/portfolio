# Copy to .env on the server and fill in real values. Never commit the
# real .env — see deployment.md Step 3.2 and the repo's Secret Safety Rule.
# This file is read two ways: docker-compose.yml uses it for ${VAR}
# substitution in the compose file itself, AND backend's service passes it
# straight through to the container via env_file.

# ── Public URL ───────────────────────────────────────────────────────────
# Used for OAuth redirects and public portfolio share links. Raw IP for
# now per deployment.md (no domain yet) — e.g. http://203.0.113.10
# No trailing slash, no port (nginx serves on 80).
FRONTEND_URL=

# ── Postgres ─────────────────────────────────────────────────────────────
# Generate strong random values — e.g. `openssl rand -hex 20`
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# DATABASE_URL is computed automatically in docker-compose.yml from the
# three values above — do not set it here, it will be ignored for the
# backend/migrate services (both override it explicitly).

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
# Same as DATABASE_URL — REDIS_URL is computed from REDIS_PASSWORD above
# in docker-compose.yml, do not set it here.

# ── GitHub OAuth ─────────────────────────────────────────────────────────
# App's "Authorization callback URL" on GitHub must be set to
# ${FRONTEND_URL}/api/auth/github/callback — update this in the GitHub
# OAuth App settings before first login, it does not come from an env var.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Colaberry SQL Server (external — not containerized) ────────────────
# Network reachability from this Hetzner server to Colaberry's SQL Server
# is untested as of this writing — verify early, may need an IP allowlist
# change on Colaberry's side. See deployment.md.
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
COLABERRY_LOGIN_URL=

# ── App secrets — generate fresh values for production, do not reuse dev ──
# `openssl rand -hex 32` for each
JWT_SECRET=
COLABERRY_SESSION_ENCRYPTION_KEY=
RESUME_DATA_ENCRYPTION_KEY=
GITHUB_TOKEN_ENCRYPTION_KEY=
