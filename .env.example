# Portfolio platform — consolidated environment variables
# Copy to .env and fill in real values. Never commit .env itself.
# Values below are placeholders only — no real secrets in this file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL — primary app datastore)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:your_local_password@localhost:5432/repo2reputation
DB_PASSWORD=your_local_postgres_password

# ---------------------------------------------------------------------------
# Auth (JWT sessions)
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string

# ---------------------------------------------------------------------------
# GitHub OAuth (user login) — SINGLE OAuth App for the merged platform
#
# IMPORTANT: R2R and Portfolioforge each originally used their own separate
# GitHub OAuth App registration with GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET
# pointing at DIFFERENT callback URLs (R2R: /api/auth/github/callback,
# scope "read:user user:email repo" | Portfolioforge: /auth/github/callback,
# scope "repo" only). Do NOT treat these as interchangeable — they were
# registered as two different GitHub Apps.
#
# Decision for the merge: R2R's OAuth App already requests `repo` scope, so
# it is sufficient for both login AND the ported GitHub-repo-publish feature.
# Portfolioforge's separate OAuth flow (server.js /auth/github,
# /auth/github/callback) is to be RETIRED in Phase 3, not ported — the
# publish-to-GitHub-repo feature should reuse the logged-in R2R user's
# existing OAuth token instead of requesting a second one.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret

# ---------------------------------------------------------------------------
# GitHub App (multi-account / private repo access) — R2R only, unrelated to
# the OAuth App above and unrelated to Portfolioforge.
# ---------------------------------------------------------------------------
GITHUB_APP_ID=your_app_id
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_PRIVATE_KEY_BASE64=base64_encoded_contents_of_pem_file

# ---------------------------------------------------------------------------
# GitHub token (server-side PAT) — used two ways with DIFFERENT required
# scopes; issue a token with enough scope to cover whichever is enabled:
#   - R2R (githubEnricher.js, repos.js): OPTIONAL fallback, public read-only,
#     just raises unauthenticated API rate limits.
#   - Portfolioforge repo-publish (legacy/portfolioforge-automation/src/index.js):
#     REQUIRED, must have repo-creation WRITE scope, or repo creation fails.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username
GITHUB_REPO_NAME=default_generated_repo_name
PORTFOLIO_MODE=create

# ---------------------------------------------------------------------------
# AI content generation
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_key
OPENROUTER_API_KEY=your_openrouter_key
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Colaberry SQL Server (READ-ONLY import source, ported from Portfolioforge)
# NOTE: this connects to Colaberry's own student/project database.
# Per CLAUDE.md governance this is a production-infrastructure boundary —
# do not enable/use in the merged app until the Phase 2 escalation to Ali
# has been written up and signed off.
# ---------------------------------------------------------------------------
SQL_SERVER=your_sql_server_host
SQL_DATABASE=your_sql_database_name
SQL_USER=your_sql_readonly_user
SQL_PASSWORD=your_sql_readonly_password
