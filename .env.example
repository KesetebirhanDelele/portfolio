# Portfolio platform — environment variables. Copy to backend/.env and fill in
# real values (backend/server.js resolves .env relative to its own cwd, not
# repo root). Never commit the real file. Placeholders only below.
#
# Consolidation notes from the Portfolioforge + Repo2Reputation merge:
#   - OPENROUTER_API_KEY, GITHUB_USERNAME, GITHUB_REPO_NAME, PORTFOLIO_MODE
#     (all from Portfolioforge) were dropped: OPENROUTER_API_KEY served the
#     same purpose as OPENAI_API_KEY (generate portfolio text) and the merged
#     app standardizes on R2R's existing OpenAI-based service; the other three
#     assumed one fixed operator identity, but the merged app is multi-user and
#     derives GitHub username / repo name / create-vs-update per request from
#     the logged-in user instead of a global env var.
#   - GITHUB_CLIENT_ID/SECRET below is R2R's OAuth App only. Portfolioforge had
#     its own separate OAuth App (different callback URL/scope) — retired; the
#     repo-publish feature reuses the logged-in user's existing R2R token.
#   - Deployment note (Hetzner): none of this file is for pulling the repo onto
#     a server. That should use a repo-scoped SSH deploy key or a fine-grained
#     PAT limited to this one repo — never your personal GitHub key/token —
#     kept in the server's ~/.ssh/config, not in this file. Your personal SSH
#     key is fine to reuse as-is for logging into the VM itself; that one has
#     no isolation benefit from being project-specific.

# --- Server ---
PORT=5000                                     # HTTP port the backend listens on
FRONTEND_URL=http://localhost:5173            # used for CORS + OAuth redirect targets

# --- Database (Postgres, app's own datastore) ---
DATABASE_URL=postgres://postgres:pw@localhost:5432/repo2reputation  # full connection string; if unset, falls back to DB_PASSWORD + local defaults
DB_PASSWORD=your_local_postgres_password      # only used when DATABASE_URL is not set

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string  # signs session JWTs; rotating invalidates all sessions
GITHUB_TOKEN_ENCRYPTION_KEY=replace_with_64_hex_chars  # AES-256-GCM key encrypting stored GitHub OAuth tokens at rest; generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- GitHub OAuth App (login + repo-publish, single app for both) ---
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret

# --- GitHub App (optional — multi-account / private-repo connect feature only) ---
GITHUB_APP_ID=your_app_id
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_PRIVATE_KEY_BASE64=base64_encoded_contents_of_pem_file

# --- GitHub token (optional server-side PAT; read-only is enough) ---
GITHUB_TOKEN=your_github_personal_access_token  # raises unauthenticated GitHub API rate limits when no user OAuth token is available

# --- AI content generation ---
OPENAI_API_KEY=sk-your_openai_key             # required — server fails to boot without at least a placeholder

# --- Colaberry SQL Server (read-only import source, ported from Portfolioforge) ---
SQL_SERVER=your_sql_server_host               # use a read-only account, not an admin login
SQL_DATABASE=your_sql_database_name
SQL_USER=your_sql_readonly_user
SQL_PASSWORD=your_sql_readonly_password

# --- Colaberry live-login (embedded browser session capture) ---
COLABERRY_LOGIN_URL=https://colaberry.example.com/login   # page the containerized browser opens for the user to log into
COLABERRY_SESSION_ENCRYPTION_KEY=replace_with_64_hex_chars  # AES-256-GCM key encrypting captured sessions at rest; generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
